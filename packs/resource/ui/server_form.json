{
    "namespace": "server_form",

    "dark_dialog_background": {
        "type": "image",
        "texture": "textures/ui/dialog_background_hollow_3",
        "size": ["100%", "100%"],
        "layer": -1
    },

    "action_button@common.button": {
        "size": ["100%", "32px"],
        "$button_sound": "random.click",
        "$pressed_button_name": "button.form_button_click",
        "$button_content": "server_form.action_button_content"
    },

    "action_button_content": {
        "type": "stack_panel",
        "orientation": "horizontal",
        "size": ["100%", "100%"],
        "controls": [
            {
                "icon_padding": {
                    "type": "panel",
                    "size": ["28px", "28px"],
                    "bindings": [
                        {
                            "binding_name": "#form_button_has_texture",
                            "binding_name_override": "#visible",
                            "binding_type": "collection",
                            "binding_collection_name": "action_buttons"
                        }
                    ],
                    "controls": [
                        {
                            "button_icon@server_form.item_icon": {
                                "size": ["24px", "24px"],
                                "anchor_from": "center",
                                "anchor_to": "center",
                                "bindings": [
                                    {
                                        "binding_name": "#form_button_texture",
                                        "binding_name_override": "#texture"
                                    },
                                    {
                                        "binding_name": "#form_button_texture_file_system",
                                        "binding_name_override": "#texture_file_system"
                                    },
                                    {
                                        "binding_type": "collection",
                                        "binding_collection_name": "action_buttons"
                                    }
                                ]
                            }
                        }
                    ]
                }
            },
            {
                "text_padding": {
                    "type": "panel",
                    "size": ["fill", "100%"],
                    "controls": [
                        {
                            "button_text": {
                                "type": "label",
                                "text": "#form_button_text",
                                "color": [0.9, 0.95, 1.0],
                                "shadow": true,
                                "anchor_from": "left_middle",
                                "anchor_to": "left_middle",
                                "offset": ["2px", "0px"],
                                "bindings": [
                                    {
                                        "binding_name": "#form_button_text",
                                        "binding_type": "collection",
                                        "binding_collection_name": "action_buttons"
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },

    "item_icon": {
        "type": "image",
        "texture": "textures/ui/empty_item"
    },

    "long_form": {
        "type": "panel",
        "size": ["100%", "100%"],
        "controls": [
            {
                "bg@server_form.dark_dialog_background": {}
            },
            {
                "main_stack": {
                    "type": "stack_panel",
                    "orientation": "vertical",
                    "size": ["92%", "90%"],
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "controls": [
                        {
                            "header_panel": {
                                "type": "panel",
                                "size": ["100%", "28px"],
                                "controls": [
                                    {
                                        "title_label": {
                                            "type": "label",
                                            "text": "#title_text",
                                            "color": [0.2, 0.9, 0.9],
                                            "shadow": true,
                                            "font_scale_factor": 1.1,
                                            "anchor_from": "center",
                                            "anchor_to": "center",
                                            "bindings": [
                                                {
                                                    "binding_name": "#title_text"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "scrolling_content@common.scrolling_panel": {
                                "size": ["100%", "fill"],
                                "$scrolling_pane_size": ["100%", "100%c"],
                                "$scrolling_content": "server_form.long_form_content"
                            }
                        }
                    ]
                }
            }
        ]
    },

    "long_form_content": {
        "type": "stack_panel",
        "orientation": "vertical",
        "size": ["100%", "100%c"],
        "controls": [
            {
                "body_panel": {
                    "type": "panel",
                    "size": ["100%", "100%c"],
                    "controls": [
                        {
                            "body_label": {
                                "type": "label",
                                "text": "#body_text",
                                "color": [0.85, 0.85, 0.85],
                                "shadow": true,
                                "anchor_from": "top_left",
                                "anchor_to": "top_left",
                                "bindings": [
                                    {
                                        "binding_name": "#body_text"
                                    }
                                ]
                            }
                        }
                    ]
                }
            },
            {
                "spacer": {
                    "type": "panel",
                    "size": ["100%", "6px"]
                }
            },
            {
                "buttons_grid": {
                    "type": "grid",
                    "size": ["100%", "100%c"],
                    "grid_dimensions": [2, 0],
                    "maximum_grid_items": 100,
                    "$collection_name": "action_buttons",
                    "factory": {
                        "name": "buttons_factory",
                        "control_name": "server_form.action_button"
                    },
                    "bindings": [
                        {
                            "binding_name": "#form_button_length",
                            "binding_name_override": "#maximum_grid_items"
                        }
                    ]
                }
            }
        ]
    },

    "modal_form": {
        "type": "panel",
        "size": ["100%", "100%"],
        "controls": [
            {
                "bg@server_form.dark_dialog_background": {}
            },
            {
                "main_stack": {
                    "type": "stack_panel",
                    "orientation": "vertical",
                    "size": ["92%", "90%"],
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "controls": [
                        {
                            "header_panel": {
                                "type": "panel",
                                "size": ["100%", "28px"],
                                "controls": [
                                    {
                                        "title_label": {
                                            "type": "label",
                                            "text": "#title_text",
                                            "color": [0.2, 0.9, 0.9],
                                            "shadow": true,
                                            "font_scale_factor": 1.1,
                                            "anchor_from": "center",
                                            "anchor_to": "center",
                                            "bindings": [
                                                {
                                                    "binding_name": "#title_text"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "body_panel": {
                                "type": "panel",
                                "size": ["100%", "fill"],
                                "controls": [
                                    {
                                        "body_label": {
                                            "type": "label",
                                            "text": "#body_text",
                                            "color": [0.85, 0.85, 0.85],
                                            "shadow": true,
                                            "anchor_from": "top_left",
                                            "anchor_to": "top_left",
                                            "bindings": [
                                                {
                                                    "binding_name": "#body_text"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "buttons_stack": {
                                "type": "stack_panel",
                                "orientation": "horizontal",
                                "size": ["100%", "32px"],
                                "controls": [
                                    {
                                        "button1@common.button": {
                                            "size": ["50%", "100%"],
                                            "$button_text": "#button1_text",
                                            "$pressed_button_name": "button.form_button1_click"
                                        }
                                    },
                                    {
                                        "button2@common.button": {
                                            "size": ["50%", "100%"],
                                            "$button_text": "#button2_text",
                                            "$pressed_button_name": "button.form_button2_click"
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },

    "custom_form": {
        "type": "panel",
        "size": ["100%", "100%"],
        "controls": [
            {
                "bg@server_form.dark_dialog_background": {}
            },
            {
                "main_stack": {
                    "type": "stack_panel",
                    "orientation": "vertical",
                    "size": ["92%", "90%"],
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "controls": [
                        {
                            "header_panel": {
                                "type": "panel",
                                "size": ["100%", "28px"],
                                "controls": [
                                    {
                                        "title_label": {
                                            "type": "label",
                                            "text": "#title_text",
                                            "color": [0.2, 0.9, 0.9],
                                            "shadow": true,
                                            "font_scale_factor": 1.1,
                                            "anchor_from": "center",
                                            "anchor_to": "center",
                                            "bindings": [
                                                {
                                                    "binding_name": "#title_text"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "scrolling_content@common.scrolling_panel": {
                                "size": ["100%", "fill"],
                                "$scrolling_pane_size": ["100%", "100%c"],
                                "$scrolling_content": "server_form.custom_form_controls"
                            }
                        }
                    ]
                }
            }
        ]
    },

    "custom_form_controls": {
        "type": "stack_panel",
        "orientation": "vertical",
        "size": ["100%", "100%c"],
        "$collection_name": "custom_form_controls"
    }
}
