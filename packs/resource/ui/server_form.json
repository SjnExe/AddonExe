{
    "namespace": "server_form",
    "third_party_server_screen@common.base_screen": {
        "$screen_content": "server_form.main_screen_content",
        "$screen_animations": ["@server_form.exit_wait"],
        "$background_animations": ["@server_form.exit_wait"],
        "force_render_below": true,
        "load_screen_immediately": true,
        "render_game_behind": true,
        "button_mappings": [
            {
                "from_button_id": "button.menu_cancel",
                "to_button_id": "button.menu_exit",
                "mapping_type": "global"
            }
        ]
    },
    "exit_wait": {
        "anim_type": "offset",
        "easing": "linear",
        "duration": 0,
        "from": [0, 0],
        "to": [0, 0],
        "play_event": "screen.exit_pop",
        "end_event": "screen.exit_end"
    },
    "main_screen_content": {
        "type": "panel",
        "size": ["100%", "100%"],
        "controls": [
            {
                "server_form_factory": {
                    "type": "factory",
                    "control_ids": {
                        "long_form": "@server_form.long_form",
                        "modal_form": "@server_form.modal_form",
                        "custom_form": "@server_form.custom_form"
                    }
                }
            }
        ]
    },
    "dark_form_frame": {
        "type": "panel",
        "size": "$form_size",
        "max_size": "$form_max_size",
        "anchor_from": "center",
        "anchor_to": "center",
        "layer": 2,
        "controls": [
            {
                "outer_shadow": {
                    "type": "image",
                    "texture": "textures/ui/Black",
                    "alpha": 0.6,
                    "size": ["100% + 4px", "100% + 4px"],
                    "layer": 1
                }
            },
            {
                "frame_border": {
                    "type": "image",
                    "texture": "textures/ui/dialog_background_opaque",
                    "color": [0.18, 0.2, 0.25],
                    "size": ["100%", "100%"],
                    "layer": 2
                }
            },
            {
                "header_bar": {
                    "type": "image",
                    "texture": "textures/ui/button_borderless_dark",
                    "color": [0.12, 0.14, 0.18],
                    "size": ["100% - 8px", 22],
                    "offset": [0, 4],
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "layer": 3,
                    "controls": [
                        {
                            "title_label": {
                                "type": "label",
                                "text": "#title_text",
                                "color": [0.95, 0.96, 0.98],
                                "shadow": true,
                                "text_alignment": "center",
                                "size": ["100% - 44px", 12],
                                "offset": [0, 1],
                                "anchor_from": "center",
                                "anchor_to": "center",
                                "layer": 4,
                                "bindings": [
                                    {
                                        "binding_name": "#title_text"
                                    }
                                ]
                            }
                        },
                        {
                            "close_button@common_buttons.dark_text_button": {
                                "size": [20, 18],
                                "offset": [-2, 0],
                                "anchor_from": "right_middle",
                                "anchor_to": "right_middle",
                                "layer": 5,
                                "$pressed_button_name": "button.menu_exit",
                                "$button_text": "§cX"
                            }
                        }
                    ]
                }
            },
            {
                "inner_recess": {
                    "type": "image",
                    "texture": "textures/ui/Black",
                    "alpha": 0.55,
                    "size": ["100% - 10px", "100% - 31px"],
                    "offset": [0, 27],
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "layer": 3,
                    "controls": [
                        {
                            "body_slot@$child_control": {
                                "size": ["100% - 4px", "100% - 4px"],
                                "anchor_from": "center",
                                "anchor_to": "center",
                                "layer": 4
                            }
                        }
                    ]
                }
            }
        ]
    },
    "long_form@server_form.dark_form_frame": {
        "$form_size": ["92%", "90%"],
        "$form_max_size": [380, 205],
        "$child_control": "server_form.exe_long_form_body"
    },
    "exe_long_form_body": {
        "type": "panel",
        "size": ["100%", "100%"],
        "layer": 1,
        "anchor_from": "top_left",
        "anchor_to": "top_left",
        "controls": [
            {
                "scrolling_panel@common.scrolling_panel": {
                    "anchor_to": "top_left",
                    "anchor_from": "top_left",
                    "$show_background": false,
                    "size": ["100%", "100%"],
                    "$scrolling_content": "server_form.long_form_scrolling_content",
                    "$scroll_size": [5, "100% - 4px"],
                    "$scrolling_pane_size": ["100% - 4px", "100% - 2px"],
                    "$scrolling_pane_offset": [2, 0],
                    "$scroll_bar_right_padding_size": [0, 0]
                }
            }
        ]
    },
    "long_form_scrolling_content": {
        "type": "stack_panel",
        "size": ["100% - 4px", "100%c"],
        "orientation": "vertical",
        "anchor_from": "top_left",
        "anchor_to": "top_left",
        "controls": [
            {
                "label_offset_panel": {
                    "type": "image",
                    "texture": "textures/ui/Black",
                    "alpha": 0.45,
                    "size": ["100%", "100%c + 6px"],
                    "bindings": [
                        {
                            "binding_name": "#form_text"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(not (#form_text = ''))",
                            "target_property_name": "#visible"
                        }
                    ],
                    "controls": [
                        {
                            "main_label": {
                                "type": "label",
                                "offset": [5, 3],
                                "color": [0.92, 0.93, 0.96],
                                "shadow": true,
                                "size": ["100% - 10px", "default"],
                                "anchor_from": "top_left",
                                "anchor_to": "top_left",
                                "text": "#form_text"
                            }
                        }
                    ]
                }
            },
            {
                "padding": {
                    "type": "panel",
                    "size": ["100%", 4],
                    "bindings": [
                        {
                            "binding_name": "#form_text"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(not (#form_text = ''))",
                            "target_property_name": "#visible"
                        }
                    ]
                }
            },
            {
                "wrapping_panel": {
                    "type": "panel",
                    "size": ["100%", "100%c"],
                    "controls": [
                        {
                            "grid_3_panel@server_form.grid_3_buttons_panel": {
                                "bindings": [
                                    {
                                        "binding_name": "#title_text"
                                    },
                                    {
                                        "binding_type": "view",
                                        "source_property_name": "(not ((#title_text - '§3') = #title_text))",
                                        "target_property_name": "#visible"
                                    }
                                ]
                            }
                        },
                        {
                            "grid_2_panel@server_form.grid_2_buttons_panel": {
                                "bindings": [
                                    {
                                        "binding_name": "#title_text"
                                    },
                                    {
                                        "binding_type": "view",
                                        "source_property_name": "(((#title_text - '§3') = #title_text) and ((#title_text - '§1') = #title_text))",
                                        "target_property_name": "#visible"
                                    }
                                ]
                            }
                        },
                        {
                            "long_form_dynamic_buttons_panel@server_form.long_form_dynamic_buttons_panel": {
                                "bindings": [
                                    {
                                        "binding_name": "#title_text"
                                    },
                                    {
                                        "binding_type": "view",
                                        "source_property_name": "(((#title_text - '§3') = #title_text) and (not ((#title_text - '§1') = #title_text)))",
                                        "target_property_name": "#visible"
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },
    "grid_3_buttons_panel": {
        "type": "grid",
        "size": ["100%", "100%c"],
        "grid_item_template": "server_form.button_tile_card",
        "grid_rescaling_type": "horizontal",
        "maximum_grid_items": 45,
        "collection_name": "form_buttons"
    },
    "grid_2_buttons_panel": {
        "type": "grid",
        "size": ["100%", "100%c"],
        "grid_item_template": "server_form.button_wide_card",
        "grid_rescaling_type": "horizontal",
        "maximum_grid_items": 40,
        "collection_name": "form_buttons"
    },
    "long_form_dynamic_buttons_panel": {
        "type": "stack_panel",
        "orientation": "vertical",
        "size": ["100%", "100%c"],
        "factory": {
            "name": "buttons",
            "control_ids": {
                "button": "@server_form.dynamic_button",
                "label": "@server_form.dynamic_label",
                "header": "@server_form.dynamic_header",
                "divider": "@settings_common.option_group_section_divider"
            }
        },
        "collection_name": "form_buttons",
        "bindings": [
            {
                "binding_name": "#form_button_contents",
                "binding_name_override": "#collection_length"
            }
        ]
    },
    "dynamic_button": {
        "type": "stack_panel",
        "orientation": "horizontal",
        "size": ["100%", 26],
        "controls": [
            {
                "row_btn@server_form.button_full_banner": {}
            }
        ]
    },
    "button_tile_card": {
        "type": "panel",
        "size": ["33.33%", "100%c"],
        "controls": [
            {
                "card_inner": {
                    "type": "panel",
                    "size": ["100%", 36],
                    "bindings": [
                        {
                            "binding_name": "#form_button_text",
                            "binding_type": "collection",
                            "binding_collection_name": "form_buttons"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(not (#form_button_text = ''))",
                            "target_property_name": "#visible"
                        }
                    ],
                    "controls": [
                        {
                            "row_stack": {
                                "type": "stack_panel",
                                "size": ["100% - 2px", 34],
                                "orientation": "horizontal",
                                "anchor_from": "center",
                                "anchor_to": "center",
                                "controls": [
                                    {
                                        "icon_panel": {
                                            "type": "panel",
                                            "size": [28, 34],
                                            "bindings": [
                                                {
                                                    "binding_name": "#form_button_texture",
                                                    "binding_name_override": "#texture",
                                                    "binding_type": "collection",
                                                    "binding_collection_name": "form_buttons"
                                                },
                                                {
                                                    "binding_type": "view",
                                                    "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
                                                    "target_property_name": "#visible"
                                                }
                                            ],
                                            "controls": [
                                                {
                                                    "icon_bg": {
                                                        "type": "image",
                                                        "texture": "textures/ui/button_borderless_dark",
                                                        "color": [0.15, 0.17, 0.22],
                                                        "layer": 1,
                                                        "size": [28, 34]
                                                    }
                                                },
                                                {
                                                    "image": {
                                                        "type": "image",
                                                        "layer": 3,
                                                        "size": [20, 20],
                                                        "anchor_from": "center",
                                                        "anchor_to": "center",
                                                        "bindings": [
                                                            {
                                                                "binding_name": "#form_button_texture",
                                                                "binding_name_override": "#texture",
                                                                "binding_type": "collection",
                                                                "binding_collection_name": "form_buttons"
                                                            },
                                                            {
                                                                "binding_name": "#form_button_texture_file_system",
                                                                "binding_name_override": "#texture_file_system",
                                                                "binding_type": "collection",
                                                                "binding_collection_name": "form_buttons"
                                                            }
                                                        ]
                                                    }
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "form_button@common_buttons.dark_text_button": {
                                            "$pressed_button_name": "button.form_button_click",
                                            "size": ["fill", 34],
                                            "$button_text": "#form_button_text",
                                            "$button_text_binding_type": "collection",
                                            "$button_text_grid_collection_name": "form_buttons",
                                            "$button_text_max_size": ["100% - 6px", 30],
                                            "bindings": [
                                                {
                                                    "binding_type": "collection_details",
                                                    "binding_collection_name": "form_buttons"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },
    "button_wide_card": {
        "type": "panel",
        "size": ["50%", "100%c"],
        "controls": [
            {
                "card_inner": {
                    "type": "panel",
                    "size": ["100%", 38],
                    "bindings": [
                        {
                            "binding_name": "#form_button_text",
                            "binding_type": "collection",
                            "binding_collection_name": "form_buttons"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(not (#form_button_text = ''))",
                            "target_property_name": "#visible"
                        }
                    ],
                    "controls": [
                        {
                            "row_stack": {
                                "type": "stack_panel",
                                "size": ["100% - 2px", 36],
                                "orientation": "horizontal",
                                "anchor_from": "center",
                                "anchor_to": "center",
                                "controls": [
                                    {
                                        "icon_panel": {
                                            "type": "panel",
                                            "size": [32, 36],
                                            "bindings": [
                                                {
                                                    "binding_name": "#form_button_texture",
                                                    "binding_name_override": "#texture",
                                                    "binding_type": "collection",
                                                    "binding_collection_name": "form_buttons"
                                                },
                                                {
                                                    "binding_type": "view",
                                                    "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
                                                    "target_property_name": "#visible"
                                                }
                                            ],
                                            "controls": [
                                                {
                                                    "icon_bg": {
                                                        "type": "image",
                                                        "texture": "textures/ui/button_borderless_dark",
                                                        "color": [0.15, 0.17, 0.22],
                                                        "layer": 1,
                                                        "size": [32, 36]
                                                    }
                                                },
                                                {
                                                    "image": {
                                                        "type": "image",
                                                        "layer": 3,
                                                        "size": [22, 22],
                                                        "anchor_from": "center",
                                                        "anchor_to": "center",
                                                        "bindings": [
                                                            {
                                                                "binding_name": "#form_button_texture",
                                                                "binding_name_override": "#texture",
                                                                "binding_type": "collection",
                                                                "binding_collection_name": "form_buttons"
                                                            },
                                                            {
                                                                "binding_name": "#form_button_texture_file_system",
                                                                "binding_name_override": "#texture_file_system",
                                                                "binding_type": "collection",
                                                                "binding_collection_name": "form_buttons"
                                                            }
                                                        ]
                                                    }
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "form_button@common_buttons.dark_text_button": {
                                            "$pressed_button_name": "button.form_button_click",
                                            "size": ["fill", 36],
                                            "$button_text": "#form_button_text",
                                            "$button_text_binding_type": "collection",
                                            "$button_text_grid_collection_name": "form_buttons",
                                            "$button_text_max_size": ["100% - 8px", 32],
                                            "bindings": [
                                                {
                                                    "binding_type": "collection_details",
                                                    "binding_collection_name": "form_buttons"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },
    "button_full_banner": {
        "type": "panel",
        "size": ["100%", 26],
        "controls": [
            {
                "row_stack": {
                    "type": "stack_panel",
                    "size": ["100%", 24],
                    "orientation": "horizontal",
                    "anchor_from": "top_left",
                    "anchor_to": "top_left",
                    "controls": [
                        {
                            "icon_panel": {
                                "type": "panel",
                                "size": [24, 24],
                                "bindings": [
                                    {
                                        "binding_name": "#form_button_texture",
                                        "binding_name_override": "#texture",
                                        "binding_type": "collection",
                                        "binding_collection_name": "form_buttons"
                                    },
                                    {
                                        "binding_type": "view",
                                        "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
                                        "target_property_name": "#visible"
                                    }
                                ],
                                "controls": [
                                    {
                                        "icon_bg": {
                                            "type": "image",
                                            "texture": "textures/ui/button_borderless_dark",
                                            "color": [0.15, 0.17, 0.22],
                                            "layer": 1,
                                            "size": [24, 24]
                                        }
                                    },
                                    {
                                        "image": {
                                            "type": "image",
                                            "layer": 3,
                                            "size": [16, 16],
                                            "anchor_from": "center",
                                            "anchor_to": "center",
                                            "bindings": [
                                                {
                                                    "binding_name": "#form_button_texture",
                                                    "binding_name_override": "#texture",
                                                    "binding_type": "collection",
                                                    "binding_collection_name": "form_buttons"
                                                },
                                                {
                                                    "binding_name": "#form_button_texture_file_system",
                                                    "binding_name_override": "#texture_file_system",
                                                    "binding_type": "collection",
                                                    "binding_collection_name": "form_buttons"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "form_button@common_buttons.dark_text_button": {
                                "$pressed_button_name": "button.form_button_click",
                                "size": ["fill", 24],
                                "$button_text": "#form_button_text",
                                "$button_text_binding_type": "collection",
                                "$button_text_grid_collection_name": "form_buttons",
                                "$button_text_max_size": ["100% - 8px", 20],
                                "bindings": [
                                    {
                                        "binding_type": "collection_details",
                                        "binding_collection_name": "form_buttons"
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },
    "dynamic_label@settings_common.option_group_spaced_label": {},
    "dynamic_header@settings_common.option_group_spaced_header": {},
    "modal_form@server_form.dark_form_frame": {
        "$form_size": ["80%", "75%"],
        "$form_max_size": [250, 145],
        "$child_control": "server_form.exe_modal_form_body"
    },
    "exe_modal_form_body": {
        "type": "panel",
        "size": ["100%", "100%"],
        "anchor_from": "top_left",
        "anchor_to": "top_left",
        "controls": [
            {
                "modal_stack": {
                    "type": "stack_panel",
                    "size": ["100%", "100%"],
                    "orientation": "vertical",
                    "controls": [
                        {
                            "body_panel": {
                                "type": "panel",
                                "size": ["100%", "fill"],
                                "controls": [
                                    {
                                        "main_label": {
                                            "type": "label",
                                            "offset": [4, 4],
                                            "color": [0.92, 0.93, 0.96],
                                            "shadow": true,
                                            "size": ["100% - 8px", "default"],
                                            "anchor_from": "top_left",
                                            "anchor_to": "top_left",
                                            "text": "#form_text"
                                        }
                                    }
                                ]
                            }
                        },
                        {
                            "buttons_stack": {
                                "type": "stack_panel",
                                "orientation": "horizontal",
                                "size": ["100%", 26],
                                "controls": [
                                    {
                                        "button1@common_buttons.dark_text_button": {
                                            "size": ["50%", "100%"],
                                            "$button_text": "#button1_text",
                                            "$pressed_button_name": "button.form_button1_click"
                                        }
                                    },
                                    {
                                        "button2@common_buttons.dark_text_button": {
                                            "size": ["50%", "100%"],
                                            "$button_text": "#button2_text",
                                            "$pressed_button_name": "button.form_button2_click"
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            }
        ]
    },
    "custom_form@server_form.dark_form_frame": {
        "$form_size": ["88%", "88%"],
        "$form_max_size": [330, 200],
        "$child_control": "server_form.exe_custom_form_body"
    },
    "exe_custom_form_body": {
        "type": "panel",
        "size": ["100%", "100%"],
        "layer": 1,
        "anchor_from": "top_left",
        "anchor_to": "top_left",
        "controls": [
            {
                "scrolling_panel@common.scrolling_panel": {
                    "anchor_to": "top_left",
                    "anchor_from": "top_left",
                    "$show_background": false,
                    "size": ["100%", "100%"],
                    "$scrolling_content": "server_form.custom_form_controls",
                    "$scroll_size": [5, "100% - 4px"],
                    "$scrolling_pane_size": ["100% - 4px", "100% - 2px"],
                    "$scrolling_pane_offset": [2, 0],
                    "$scroll_bar_right_padding_size": [0, 0]
                }
            }
        ]
    },
    "custom_form_controls": {
        "type": "stack_panel",
        "orientation": "vertical",
        "size": ["100% - 4px", "100%c"],
        "$collection_name": "custom_form",
        "factory": {
            "name": "custom_form_factory",
            "control_ids": {
                "header": "@server_form.custom_header",
                "toggle": "@server_form.custom_toggle",
                "slider": "@server_form.custom_slider",
                "step_slider": "@server_form.custom_step_slider",
                "dropdown": "@server_form.custom_dropdown",
                "multiselect": "@server_form.custom_multiselect",
                "input": "@server_form.custom_input"
            }
        }
    },
    "custom_header@settings_common.option_group_header": {
        "$text": "#custom_text",
        "$text_bindings": [
            {
                "binding_name": "#custom_text",
                "binding_type": "collection",
                "binding_collection_name": "custom_form"
            }
        ]
    },
    "custom_toggle@settings_common.option_toggle": {
        "$option_label": "#custom_text",
        "$toggle_name": "custom_toggle",
        "$toggle_state_binding_name": "#custom_toggle_state",
        "$option_binding_name": "#custom_toggle_state",
        "$toggle_binding_type": "collection",
        "$toggle_enabled_binding_name": "#custom_toggle_enabled",
        "$toggle_enabled_binding_type": "collection",
        "$toggle_grid_collection_name": "custom_form",
        "$option_tooltip_binding_type": "collection",
        "$option_tooltip_collection_name": "custom_form",
        "$option_tooltip_text_binding_name": "#custom_tooltip_text",
        "$option_tooltip_area": "inside_header_panel",
        "$label_bindings": [
            {
                "binding_name": "#custom_text",
                "binding_type": "collection",
                "binding_collection_name": "custom_form"
            }
        ]
    },
    "custom_slider@settings_common.option_slider": {
        "$option_label": "#custom_slider_text",
        "$slider_name": "custom_slider",
        "$slider_value_binding_name": "#custom_slider_value",
        "$slider_tts_text_value": "#custom_slider_text_value",
        "$slider_binding_type": "collection",
        "$slider_collection_name": "custom_form",
        "$slider_enabled_binding_name": "#custom_slider_enabled",
        "$slider_enabled_binding_type": "collection",
