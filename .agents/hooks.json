{
  "auto-formatter": {
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "bun scripts/hooks/antigravityFormat.ts 2>/dev/null || bun ../scripts/hooks/antigravityFormat.ts",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "safety-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bun scripts/hooks/antigravitySafety.ts 2>/dev/null || bun ../scripts/hooks/antigravitySafety.ts",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
