{
    "name": "AddonExe",
    "version": "0.7.0",
    "private": true,
    "description": "<p align=\"center\"> <h1 align=\"center\">AddonExe for Minecraft BE</h1> </p>",
    "keywords": [],
    "homepage": "https://github.com/SjnExe/AddonExe#readme",
    "bugs": {
        "url": "https://github.com/SjnExe/AddonExe/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/SjnExe/AddonExe.git"
    },
    "license": "MIT",
    "author": "SjnExe",
    "type": "module",
    "scripts": {
        "build": "bun clean && bun scripts/build/build.ts",
        "build:nightly": "bun clean && bun scripts/build/build.ts --nightly",
        "build:release": "bun clean && bun scripts/build/build.ts --release --minify",
        "check-deps": "bun scripts/build/check-dependencies.ts",
        "check-types": "bun check",
        "clean": "rm -rf out packs/behavior/scripts",
        "format": "bunx prettier --write --cache .",
        "format:check": "bunx prettier --check --cache .",
        "postinstall": "bun scripts/hooks/postinstall.ts",
        "lint": "bun scripts/lint/run.ts --fix",
        "lint:check": "bun scripts/lint/run.ts",
        "lint:report": "bun scripts/lint/oxlint.ts -f json > oxlint_report.json",
        "mc-update": "bun scripts/build/mc-update.ts",
        "project-info": "bunx mct info -i packs",
        "reinstall": "rm -rf node_modules bun.lockb bun.lock && bun install",
        "test": "bun test",
        "test:dupe": "bun scripts/lint/test-duplication.ts",
        "test:watch": "bun test --watch",
        "validate": "bun scripts/hooks/validate.ts",
        "watch": "bun scripts/build/build.ts --watch"
    },
    "lint-staged": {
        "*.{js,ts}": "bun scripts/lint/staged.ts",
        "*.{json,md,yml,yaml}": "bunx prettier --write --cache"
    },
    "overrides": {
        "react": "^18.3.1"
    },
    "dependencies": {
        "@minecraft/math": "latest",
        "@minecraft/vanilla-data": "latest"
    },
    "devDependencies": {
        "@minecraft/bedrock-schemas": "beta",
        "@minecraft/common": "latest",
        "@minecraft/creator-tools": "latest",
        "@minecraft/server": "2.11.0-beta.1.26.52-stable",
        "@minecraft/server-ui": "2.3.0-beta.1.26.52-stable",
        "@types/bun": "latest",
        "@types/jszip": "latest",
        "ajv": "latest",
        "eslint-plugin-minecraft-linting": "latest",
        "jscpd": "^4.3.0",
        "jszip": "latest",
        "lint-staged": "latest",
        "oxlint": "latest",
        "prettier": "latest",
        "prettier-plugin-organize-imports": "latest",
        "prettier-plugin-packagejson": "latest"
    }
}
